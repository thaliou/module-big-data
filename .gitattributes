# Fins de ligne Unix obligatoires pour tout ce qui s'exécute dans les conteneurs Linux
# (un mapper.py en CRLF fait échouer Hadoop Streaming)
* text=auto
*.py   text eol=lf
*.sh   text eol=lf
*.xml  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.csv  text eol=lf
Dockerfile text eol=lf
*.ps1  text eol=crlf
*.png  binary
*.jpg  binary
